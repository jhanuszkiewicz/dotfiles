# Ukrywa górny pasek systemowy macOS
window-decoration = true

# Ustawia marginesy, dając tekstowi więcej "oddechu" od krawędzi okna
window-padding-x = 10
window-padding-y = 10

# Włącza efekt zamazanego szkła znany z systemu macOS
background-blur-radius = 20

background-opacity = 1

# Color theme

theme = TokyoNight Storm
font-family = JetBrainsMono Nerd Font
font-size = 14
background-opacity = 0.92
macos-titlebar-style = hidden
window-padding-x = 12
window-padding-y = 12
