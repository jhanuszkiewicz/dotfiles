# ghostty - tokyo preset
# (only used when the active preset's term/app says Ghostty)

# ---------- window ----------
# none = no titlebar and square corners (auto + hidden titlebar keeps macos rounded corners)
window-decoration = none
macos-titlebar-style = hidden
window-padding-x = 20
# no padding on top (0), 16 on the bottom - nvim's first row sits right at the top edge
window-padding-y = 0,16
# padding takes the color of the nearest cells, so nvim (tree, statusline) reaches the window edge
window-padding-color = extend
macos-window-shadow = false
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# every window starts in tmux 
command = /Users/jhan/.dotfiles/scripts/tmux-start

# ---------- font ----------
font-family = CaskaydiaCove Nerd Font
font-style = Regular
font-style-bold = SemiBold
font-style-italic = Italic
font-style-bold-italic = SemiBold Italic
# font-family = JetBrainsMono Nerd Font
font-size = 17

# ---------- colors (tokyo night storm) ----------
background = 1a1b26
foreground = a9b1d6
cursor-color = c0caf5
selection-background = 364a82
selection-foreground = c0caf5
palette = 0=#32344a
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#ad8ee6
palette = 6=#449dab
palette = 7=#9699a8
palette = 8=#444b6a
palette = 9=#ff7a93
palette = 10=#b9f27c
palette = 11=#ff9e64
palette = 12=#7da6ff
palette = 13=#bb9af7
palette = 14=#0db9d7
palette = 15=#acb0d0

# cursor trail drawn by ghostty itself, so it works everywhere: nvim, shell, across tmux panes
# (shaders/cursor_warp.glsl, settings like DURATION and TRAIL_SIZE at the top of that file)
custom-shader = shaders/cursor_warp.glsl
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true

# ---------- keys ----------
# caps lock = esc/ctrl in karabiner: esc can arrive while ctrl is still held, so treat ctrl+esc as plain esc
keybind = ctrl+escape=text:\x1b
