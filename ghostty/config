# ghostty - minimalist preset
# (only used when the active preset's term/app says Ghostty)

# ---------- window ----------
# none = no titlebar AND no native border, so macos doesn't round the corners
window-decoration = none
window-padding-x = 20
window-padding-y = 16
macos-window-shadow = false
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# every window starts in tmux
command = /Users/jhan/.dotfiles/scripts/tmux-start

# ---------- font ----------
# like the inspo config: Tamzen first, Inconsolata Medium for anything Tamzen doesn't have
# (Tamzen10x20 = our renamed copy from ~/.dotfiles/fonts, polish letters already inside)
font-family = Tamzen10x20
font-family = Inconsolata Medium
font-family-bold = Tamzen10x20
font-family-bold = Inconsolata Medium
font-style = Bold
font-style-bold = Bold
# 20 = tamzen w podwojnej skali pikseli, wiec jest ostry (13 bylo za male)
font-size = 23
# = line_height 0.9 from the wezterm config
adjust-cell-height = -10%
font-thicken = false

# ---------- colors (gruvbox dark) ----------
background = 282828
foreground = d5c4a1
cursor-color = ebdbb2
selection-background = a89984
selection-foreground = 282828
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true
