#!/bin/bash
# borders - hypr preset
# hyprland-style gradient border: mauve -> blue on the focused window,
# a faint one on the rest
# no background_color here - it would paint behind the window and kill
# the terminal transparency

options=(
  style=round
  width=4.0
  hidpi=on
  active_color="gradient(top_left=0xffcba6f7,bottom_right=0xff89b4fa)"
  inactive_color=0x40585b70
)

borders "${options[@]}"
