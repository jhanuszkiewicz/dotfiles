#!/bin/bash
# minimalist - square, solid, terminal-like frames
#
# background_color fills the space behind the window inside the border,
# so the rounded tahoe corners get filled with the terminal background color
# and the window looks fully square (same trick as the old square tokyo config)

options=(
  style=square
  width=5.0
  hidpi=on
  active_color=0xff7c6f64
  inactive_color=0xff32302f
  background_color=0xff282828
)

borders "${options[@]}"
