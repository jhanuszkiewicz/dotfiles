# ghostty - tokyo-gruv preset
# (only used when the active preset's term/app says Ghostty)

# ---------- window ----------
# auto + hidden titlebar = no titlebar, but macos keeps the rounded corners
window-decoration = auto
macos-titlebar-style = hidden
window-padding-x = 20
window-padding-y = 16
macos-window-shadow = false
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# every window starts in tmux 
command = /Users/jhan/.dotfiles/scripts/tmux-start

# ---------- font ----------
font-family = JetBrainsMono Nerd Font
font-size = 17

# ---------- colors (gruvbox dark, warm graphite bg #2a2522 instead of #282828) ----------
background = 2a2522
foreground = ebdbb2
cursor-color = ebdbb2
selection-background = 504945
selection-foreground = ebdbb2
palette = 0=#2a2522
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true

# ---------- keys ----------
# caps lock = esc/ctrl in karabiner: esc can arrive while ctrl is still held, so treat ctrl+esc as plain esc
keybind = ctrl+escape=text:\x1b
