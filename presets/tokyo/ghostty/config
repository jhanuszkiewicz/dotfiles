# ghostty - tokyo preset
# (only used when the active preset's term/app says Ghostty)

# ---------- window ----------
# none = no titlebar AND no native border, so macos doesn't round the corners
window-decoration = none
window-padding-x = 20
window-padding-y = 16
macos-window-shadow = false
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# every window starts in tmux 
command = /Users/jhan/.dotfiles/scripts/tmux-start

# ---------- font ----------
font-family = JetBrainsMono Nerd Font
font-size = 18

# ---------- colors (tokyo night storm) ----------
background = 24283b
foreground = a9b1d6
cursor-color = c0caf5
selection-background = 364a82
selection-foreground = c0caf5
palette = 0=#32344a
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#ad8ee6
palette = 6=#449dab
palette = 7=#9699a8
palette = 8=#444b6a
palette = 9=#ff7a93
palette = 10=#b9f27c
palette = 11=#ff9e64
palette = 12=#7da6ff
palette = 13=#bb9af7
palette = 14=#0db9d7
palette = 15=#acb0d0

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true
