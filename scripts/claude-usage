#!/usr/bin/env python3
# claude-usage - current claude.ai limits (5 h window + week) for sketchybar
#
#   claude-usage         -> fetch, write the cache, poke sketchybar
#   claude-usage --json  -> also print the raw response
#
# runs every 5 min from launchd (com.jhan.claude-usage). the morning poke that
# opens the 5 h window is a cloud routine, this only reads.
#
# token comes from the keychain entry claude code uses. when it's expired we
# refresh it the same way the cli does and write it back in the same format,
# otherwise the cli would be left with a dead (rotated) refresh token.
# /api/oauth/usage is undocumented - on any error the cache is left alone.

import getpass
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from datetime import datetime

SERVICE = "Claude Code-credentials"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
# cloudflare in front of both endpoints rejects the default python-urllib agent
UA = "claude-usage/1.0"
CACHE = os.path.expanduser("~/.cache/sketchybar/claude-usage")


def keychain_read():
    out = subprocess.run(["security", "find-generic-password", "-s", SERVICE, "-w"],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out)


def keychain_write(creds):
    subprocess.run(["security", "add-generic-password", "-U", "-s", SERVICE,
                    "-a", getpass.getuser(), "-w", json.dumps(creds)],
                   capture_output=True, check=True)


def post_json(url, body, headers=None):
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST",
                                 headers={"Content-Type": "application/json", "User-Agent": UA, **(headers or {})})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def get_json(url, headers):
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": UA, **headers}), timeout=20) as r:
        return json.load(r)


def access_token():
    creds = keychain_read()
    o = creds["claudeAiOauth"]
    # 5 min margin so the token doesn't die halfway through the request
    if o["expiresAt"] / 1000 > time.time() + 300:
        return o["accessToken"]

    new = post_json(TOKEN_URL, {
        "grant_type": "refresh_token",
        "refresh_token": o["refreshToken"],
        "client_id": CLIENT_ID,
        "scope": " ".join(o.get("scopes", [])),
    })
    o["accessToken"] = new["access_token"]
    o["refreshToken"] = new.get("refresh_token", o["refreshToken"])
    o["expiresAt"] = int((time.time() + new.get("expires_in", 3600)) * 1000)
    keychain_write(creds)
    return o["accessToken"]


def epoch(iso):
    if not iso:
        return 0
    return int(datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp())


def main():
    try:
        data = get_json(USAGE_URL, {
            "Authorization": "Bearer " + access_token(),
            "anthropic-beta": "oauth-2025-04-20",
        })
    except Exception as e:
        print(f"claude-usage: {e}", file=sys.stderr)
        sys.exit(1)

    five = data.get("five_hour") or {}
    week = data.get("seven_day") or {}
    # one line the sketchybar plugin can `read`:
    # 5h_percent 5h_reset_epoch week_percent week_reset_epoch fetched_epoch
    line = "%d %d %d %d %d\n" % (
        round(five.get("utilization") or 0), epoch(five.get("resets_at")),
        round(week.get("utilization") or 0), epoch(week.get("resets_at")),
        time.time())

    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE + ".tmp", "w") as f:
        f.write(line)
    os.replace(CACHE + ".tmp", CACHE)

    if "--json" in sys.argv:
        print(json.dumps(data, indent=2))

    bar = shutil.which("sketchybar") or "/opt/homebrew/bin/sketchybar"
    if os.path.exists(bar):
        subprocess.run([bar, "--trigger", "claude_usage"], capture_output=True)


if __name__ == "__main__":
    main()
