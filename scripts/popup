#!/bin/sh
# popup TITLE COMMAND
# small floating kitty window with COMMAND, it closes together with the command
# size and position come from paneru: [windows.<title>] with a grid in paneru.toml
#
# kitty opens it straight at the spot paneru will move it to (same math as paneru:
# screen minus menu bar/notch minus [padding], then the grid), otherwise it pops up
# at kitty's default spot and size first and visibly jumps

title=$1
cmd=$2

TOML="$HOME/.dotfiles/paneru/paneru.toml"
SCREEN="/tmp/popup_screen_$USER"

# screen size + menu bar/notch height, asked once and kept for 10 min
if [ -z "$(find "$SCREEN" -mmin -10 2>/dev/null)" ]; then
  osascript -l JavaScript -e '
    ObjC.import("AppKit")
    var s = $.NSScreen.mainScreen
    var f = s.frame
    var v = s.visibleFrame
    var bar = f.size.height - (v.origin.y + v.size.height)
    var notch = s.safeAreaInsets.top
    Math.round(f.size.width) + " " + Math.round(f.size.height) + " " + Math.round(Math.max(bar, notch))
  ' > "$SCREEN" 2>/dev/null
fi

geo=$(awk -v want="[windows.$title]" -v screen="$(cat "$SCREEN" 2>/dev/null)" '
  { gsub(/"/, "") }
  /^\[/ { sec = $0 }
  sec == "[padding]" && $2 == "=" { pad[$1] = $3 }
  sec == want && $1 == "grid" { grid = $3 }
  END {
    split(screen, s, " ")
    split(grid, g, ":")
    if (s[1] == "" || g[6] == "" || g[1] == 0 || g[2] == 0) exit
    x0 = pad["left"]
    y0 = s[3] + pad["top"]
    w = s[1] - pad["left"] - pad["right"]
    h = s[2] - s[3] - pad["top"] - pad["bottom"]
    printf "%d %d %d %d", x0 + w * g[3] / g[1] + 0.5, y0 + h * g[4] / g[2] + 0.5, w * g[5] / g[1] + 0.5, h * g[6] / g[2] + 0.5
  }' "$TOML")

# own kitty instance, so it quits as soon as the command ends
# --title has to come first, toggle-* look for "kitty --title=<name>"
if [ -n "$geo" ]; then
  set -- $geo
  exec open -na kitty --args --title="$title" \
    --position "${1}x${2}" \
    -o initial_window_width="$3" -o initial_window_height="$4" \
    -o macos_quit_when_last_window_closed=yes \
    -o remember_window_size=no \
    "$cmd"
fi

exec open -na kitty --args --title="$title" \
  -o macos_quit_when_last_window_closed=yes \
  -o remember_window_size=no \
  "$cmd"
