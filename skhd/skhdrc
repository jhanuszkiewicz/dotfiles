# Terminal

# Open new terminal window
lalt - return : ~/.dotfiles/scripts/open-term

# Launchers

# Toggle app launcher (opens the picked app in a new window)
alt - space : ~/.dotfiles/scripts/toggle-launcher.sh

# Toggle window list (all open and minimized windows, enter jumps there)
lalt - tab : ~/.dotfiles/scripts/toggle-windows.sh

# Toggle shortcut search (alt + k is for tmux)
lalt + shift - k : ~/.dotfiles/scripts/toggle-keys.sh

# Toggle menu search (menus of the app you're in, the macos menu bar stays hidden)
lalt - m : ~/.dotfiles/scripts/toggle-menu.sh

# Toggle control center (wifi, bluetooth, audio, focus...)
lalt + shift - c : ~/.dotfiles/scripts/toggle-ctl.sh

# Toggle anki review (clanki, syncs before and after)
lalt + shift - a : ~/.dotfiles/scripts/toggle-anki.sh

# Volume

# Volume keys without the macOS popup - the notch island in sketchybar shows the change
sound_up : osascript -e 'set volume output volume ((output volume of (get volume settings)) + 6)'
sound_down : osascript -e 'set volume output volume ((output volume of (get volume settings)) - 6)'
mute : osascript -e 'set volume output muted (not (output muted of (get volume settings)))'

# Focus left/right along the paneru strip, with an empty desktop before the first window
# (h on the first window = workspace 9 with just the wallpaper + widgets, l = back)
ctrl + alt - h : ~/.dotfiles/scripts/desk-nav west
ctrl + alt - l : ~/.dotfiles/scripts/desk-nav east
